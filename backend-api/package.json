{
  "name": "tharwa-backend-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "prisma migrate deploy && prisma generate",
    "migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "verify:movers": "node scripts/verify-egx-movers.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@mathieuc/tradingview": "^3.5.2",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^9.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.19.0",
    "ioredis-mock": "^8.9.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
