generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstrumentKind {
  fx
  metal
  equity
}

enum QuoteCategory {
  official
  indicative
  estimate
}

enum SessionState {
  open
  closed
  pre
  post
  unknown
}

enum JournalSide {
  buy
  sell
}

enum UpstreamType {
  fx
  metals
  equities
}

enum MetalUnit {
  gram
  troy_ounce
}

enum OhlcvResolution {
  d1
  w1
  m1
  y1
}

enum PriceAlertDirection {
  above
  below
}

enum PushPlatform {
  ios
  android
}

enum AnnouncementVariant {
  info
  warning
  maintenance
}

enum CorporateCalendarEventKind {
  dividend
  agm
  egm
  general
  other
}

enum CorporateCalendarDividendSubKind {
  entitlement
  payment
  unspecified
}

enum SitePageKind {
  standard
  contact
}

enum SiteMenuPlacement {
  header
  footer
}

enum SiteMenuLinkType {
  page
  external
}

enum EgxHolidaySource {
  calendarlabs
  admin
}

enum NetWorthComponentKind {
  asset
  liability
}

enum NetWorthCategory {
  cash
  certificate
  real_estate
  other_asset
  loan
  other_liability
}

enum FinancialGoalStatus {
  active
  achieved
  past_due
}

enum GoalSavedSource {
  manual
  net_worth
  category
}

enum EquityListKind {
  sector
  thematic
  market_rule
}

enum EquityListMemberSource {
  import
  admin
  sync
}

model Instrument {
  id                String         @id @default(uuid())
  kind              InstrumentKind
  code              String         @unique
  displayNameAr     String         @map("display_name_ar")
  displayNameEn     String         @map("display_name_en")
  isConsumerVisible Boolean        @default(true) @map("is_consumer_visible")
  sortOrder         Int            @default(0) @map("sort_order")
  /// Equity: `{ "tvSymbol": "EGX:COMI" }`. Prefer typed relations for metals (see `metalKaratRules`).
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  quoteSnapshots  QuoteSnapshot[]
  watchlistItems  WatchlistItem[]
  journalEntries  TradeJournalEntry[]
  simTrades       SimTrade[]
  metalKaratRules MetalKaratRule[]
  ohlcvBars       OhlcvBar[]
  priceAlerts     PriceAlert[]
  calendarEvents  CorporateCalendarEvent[]

  @@map("instruments")
}

/// EGX corporate calendar (Mubasher AMR — synced daily).
model CorporateCalendarEvent {
  id              String                            @id @default(uuid())
  source          String                            @default("mubasher")
  sourceKey       String                            @map("source_key")
  symbol          String
  instrumentId    String?                           @map("instrument_id")
  instrument      Instrument?                       @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  eventDate       DateTime                          @map("event_date") @db.Date
  eventDateEnd    DateTime?                         @map("event_date_end") @db.Date
  kind            CorporateCalendarEventKind
  dividendSubKind CorporateCalendarDividendSubKind? @map("dividend_sub_kind")
  titleAr         String                            @map("title_ar")
  titleEn         String                            @map("title_en")
  agendaAr        String?                           @map("agenda_ar")
  agendaEn        String?                           @map("agenda_en")
  hostNameAr      String?                           @map("host_name_ar")
  hostNameEn      String?                           @map("host_name_en")
  placeAr         String?                           @map("place_ar")
  placeEn         String?                           @map("place_en")
  eventTime       String?                           @map("event_time")
  raw             Json?
  syncedAt        DateTime                          @map("synced_at")
  createdAt       DateTime                          @default(now()) @map("created_at")
  updatedAt       DateTime                          @updatedAt @map("updated_at")

  @@unique([source, sourceKey])
  @@index([eventDate])
  @@index([symbol, eventDate])
  @@map("corporate_calendar_events")
}

model CorporateCalendarSyncRun {
  id             String   @id @default(uuid())
  success        Boolean
  eventsUpserted Int      @default(0) @map("events_upserted")
  errorMessage   String?  @map("error_message")
  attemptCount   Int      @default(1) @map("attempt_count")
  finishedAt     DateTime @default(now()) @map("finished_at")

  @@index([finishedAt(sort: Desc)])
  @@map("corporate_calendar_sync_runs")
}

/// EGX exchange closure dates — synced from CalendarLabs and admin ad-hoc entries.
model EgxMarketHoliday {
  id               String           @id @default(uuid())
  holidayDate      DateTime         @unique @map("holiday_date") @db.Date
  nameEn           String           @map("name_en")
  nameAr           String?          @map("name_ar")
  source           EgxHolidaySource @default(calendarlabs)
  createdByAdminId String?          @map("created_by_admin_id")
  createdByAdmin   AdminUser?       @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([holidayDate])
  @@index([source])
  @@map("egx_market_holidays")
}

model EgxHolidaySyncRun {
  id             String   @id @default(uuid())
  success        Boolean
  years          Int[]    @default([])
  holidaysUpserted Int    @default(0) @map("holidays_upserted")
  errorMessage   String?  @map("error_message")
  finishedAt     DateTime @default(now()) @map("finished_at")

  @@index([finishedAt(sort: Desc)])
  @@map("egx_holiday_sync_runs")
}

/// Gold karat pricing derived from a 24k gram anchor (replaces untyped `metadata` karat math).
model MetalKaratRule {
  id               String     @id @default(uuid())
  instrumentId     String     @map("instrument_id")
  instrument       Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  karat            Int?
  unit             MetalUnit  @default(gram)
  /// `amountEgp = anchor24kGramEgp * priceNumerator / priceDenominator` (troy oz uses × ounce grams when unit is troy_ounce).
  priceNumerator   Int        @default(21) @map("price_numerator")
  priceDenominator Int        @default(24) @map("price_denominator")
  sortOrder        Int        @default(0) @map("sort_order")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([instrumentId, karat, unit])
  @@map("metal_karat_rules")
}

model QuoteSnapshot {
  id            String        @id @default(uuid())
  instrumentId  String        @map("instrument_id")
  instrument    Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  asOf          DateTime      @map("as_of")
  bid           Decimal?      @db.Decimal(24, 8)
  ask           Decimal?      @db.Decimal(24, 8)
  last          Decimal?      @db.Decimal(24, 8)
  changePct     Decimal?      @map("change_pct") @db.Decimal(12, 6)
  volume        BigInt?
  quoteCategory QuoteCategory @map("quote_category")
  sessionState  SessionState  @map("session_state")
  raw           Json?

  @@index([instrumentId, asOf(sort: Desc)])
  @@map("quote_snapshots")
}

/// Persisted OHLCV for charting (optional cache behind live connector fetches).
model OhlcvBar {
  id           String          @id @default(uuid())
  instrumentId String          @map("instrument_id")
  instrument   Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  resolution   OhlcvResolution
  barTime      DateTime        @map("bar_time")
  open         Decimal         @db.Decimal(24, 8)
  high         Decimal         @db.Decimal(24, 8)
  low          Decimal         @db.Decimal(24, 8)
  close        Decimal         @db.Decimal(24, 8)
  volume       BigInt?
  source       String          @default("tradingview")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([instrumentId, resolution, barTime])
  @@index([instrumentId, resolution, barTime(sort: Desc)])
  @@map("ohlcv_bars")
}

model UpstreamConnection {
  id            String       @id @default(uuid())
  name          String
  type          UpstreamType
  enabled       Boolean      @default(true)
  config        Json
  secretRef     String?      @map("secret_ref")
  lastSuccessAt DateTime?    @map("last_success_at")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("upstream_connections")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  totpSecret   String?  @map("totp_secret")
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  role         String   @default("operator")
  createdAt    DateTime @default(now()) @map("created_at")

  auditLogs            AdminAuditLog[]
  platformIntegrations PlatformIntegration[]
  announcements        ConsumerAnnouncement[]
  egxHolidaysCreated   EgxMarketHoliday[]
  learnArticlesCreated LearnArticle[]

  @@map("admin_users")
}

/// Admin-managed in-app banners (Eid greetings, EGX closure, maintenance, etc.).
model ConsumerAnnouncement {
  id               String              @id @default(uuid())
  titleAr          String              @map("title_ar")
  titleEn          String              @map("title_en")
  bodyAr           String              @map("body_ar")
  bodyEn           String              @map("body_en")
  variant          AnnouncementVariant @default(info)
  sortOrder        Int                 @default(0) @map("sort_order")
  isEnabled        Boolean             @default(true) @map("is_enabled")
  dismissible      Boolean             @default(true)
  linkUrl          String?             @map("link_url")
  startsAt         DateTime?           @map("starts_at")
  endsAt           DateTime?           @map("ends_at")
  createdByAdminId String?             @map("created_by_admin_id")
  createdByAdmin   AdminUser?          @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([isEnabled, startsAt, endsAt, sortOrder])
  @@map("consumer_announcements")
}

/// Admin-managed third-party credentials (FCM, etc.). Secrets are never returned on read APIs.
model PlatformIntegration {
  slug             String     @id
  displayName      String     @map("display_name")
  config           Json
  updatedByAdminId String?    @map("updated_by_admin_id")
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("platform_integrations")
}

model AdminAuditLog {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  payload     Json?
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model ConsumerUser {
  id              String    @id @default(uuid())
  email           String    @unique
  displayName     String?   @map("display_name")
  phone           String?
  passwordHash    String?   @map("password_hash")
  authSubject     String?   @map("auth_subject")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  watchlistItems      WatchlistItem[]
  journalEntries      TradeJournalEntry[]
  simAccount          SimAccount?
  refreshTokens       ConsumerRefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerification[]
  priceAlerts         PriceAlert[]
  pushDevices         PushDevice[]
  zakatSessions       ZakatSession[]
  contactSubmissions  ContactSubmission[]
  notifications       ConsumerNotification[]
  netWorthComponents  ManualNetWorthComponent[]
  netWorthSnapshots   NetWorthSnapshot[]
  financialGoals      FinancialGoal[]

  @@map("consumer_users")
}

/// In-app "Contact us" form submissions from mobile (guest or signed-in).
model ContactSubmission {
  id             String        @id @default(uuid())
  name           String
  email          String
  subject        String?
  message        String
  consumerUserId String?       @map("consumer_user_id")
  consumerUser   ConsumerUser? @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  ip             String?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("contact_submissions")
}

/// Saved zakat calculator run (inputs + result snapshot).
model ZakatSession {
  id                  String       @id @default(uuid())
  consumerUserId      String       @map("consumer_user_id")
  consumerUser        ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  label               String?
  yearType            String       @map("year_type")
  nisabAttainmentDate DateTime?    @map("nisab_attainment_date") @db.Date
  inputs              Json
  result              Json
  zakatDueEgp         Decimal      @map("zakat_due_egp") @db.Decimal(24, 4)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@index([consumerUserId, createdAt(sort: Desc)])
  @@map("zakat_sessions")
}

/// FCM device token for push notifications (anonymous or linked to a consumer account).
model PushDevice {
  id             String        @id @default(uuid())
  fcmToken       String        @unique @map("fcm_token")
  platform       PushPlatform
  consumerUserId String?       @map("consumer_user_id")
  consumerUser   ConsumerUser? @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  /// Client-stable id to re-link the same install when the FCM token rotates.
  installId      String?       @map("install_id")
  /// App UI locale (`ar` | `en`) for localized push copy.
  locale         String?       @map("locale")
  lastSeenAt     DateTime      @map("last_seen_at")
  disabledAt     DateTime?     @map("disabled_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([consumerUserId])
  @@index([platform, disabledAt])
  @@index([installId])
  @@map("push_devices")
}

/// In-app notification history (daily briefs and other push types).
model ConsumerNotification {
  id             String        @id @default(uuid())
  consumerUserId String?       @map("consumer_user_id")
  consumerUser   ConsumerUser? @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  installId      String?       @map("install_id")
  type           String
  locale         String
  title          String
  body           String
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([installId, locale, createdAt(sort: Desc)])
  @@index([consumerUserId, locale, createdAt(sort: Desc)])
  @@map("consumer_notifications")
}

model ConsumerRefreshToken {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([consumerUserId, expiresAt])
  @@map("consumer_refresh_tokens")
}

model PasswordResetToken {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  usedAt         DateTime?    @map("used_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([consumerUserId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerification {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  verifiedAt     DateTime?    @map("verified_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([consumerUserId, expiresAt])
  @@map("email_verifications")
}

model WatchlistItem {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  instrumentId   String       @map("instrument_id")
  instrument     Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  position       Int          @default(0)

  @@unique([consumerUserId, instrumentId])
  @@map("watchlist_items")
}

model TradeJournalEntry {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  instrumentId   String       @map("instrument_id")
  instrument     Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  side           JournalSide
  quantity       Decimal      @db.Decimal(24, 8)
  price          Decimal      @db.Decimal(24, 8)
  executedAt     DateTime     @map("executed_at") @db.Date
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("trade_journal_entries")
}

/// Virtual practice account (paper trading) — separate from trade journal / portfolio.
model SimAccount {
  id              String       @id @default(uuid())
  consumerUserId  String       @unique @map("consumer_user_id")
  consumerUser    ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  startingCashEgp Decimal      @map("starting_cash_egp") @db.Decimal(24, 4)
  cashEgp         Decimal      @map("cash_egp") @db.Decimal(24, 4)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  trades SimTrade[]

  @@map("sim_accounts")
}

model SimTrade {
  id           String      @id @default(uuid())
  simAccountId String      @map("sim_account_id")
  simAccount   SimAccount  @relation(fields: [simAccountId], references: [id], onDelete: Cascade)
  instrumentId String      @map("instrument_id")
  instrument   Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  side         JournalSide
  quantity     Decimal     @db.Decimal(24, 8)
  fillPriceEgp Decimal     @map("fill_price_egp") @db.Decimal(24, 8)
  quoteAsOf    DateTime?   @map("quote_as_of")
  filledAt     DateTime    @default(now()) @map("filled_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([simAccountId, filledAt(sort: Desc)])
  @@map("sim_trades")
}

model PriceAlert {
  id              String              @id @default(uuid())
  consumerUserId  String              @map("consumer_user_id")
  consumerUser    ConsumerUser        @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  instrumentId    String              @map("instrument_id")
  instrument      Instrument          @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  direction       PriceAlertDirection
  threshold       Decimal             @db.Decimal(24, 8)
  isEnabled       Boolean             @default(true) @map("is_enabled")
  lastTriggeredAt DateTime?           @map("last_triggered_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([consumerUserId, isEnabled])
  @@index([instrumentId, isEnabled])
  @@map("price_alerts")
}

/// Public marketing site CMS pages (privacy, about, contact intro, etc.).
model SitePage {
  id          String       @id @default(uuid())
  slug        String       @unique
  titleAr     String       @map("title_ar")
  titleEn     String       @map("title_en")
  contentAr   String       @map("content_ar") @db.Text
  contentEn   String       @map("content_en") @db.Text
  kind        SitePageKind @default(standard)
  isPublished Boolean      @default(false) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  menuItems SiteMenuItem[]

  @@map("site_pages")
}

/// Header/footer navigation items for the public website.
model SiteMenuItem {
  id          String            @id @default(uuid())
  placement   SiteMenuPlacement
  labelAr     String            @map("label_ar")
  labelEn     String            @map("label_en")
  linkType    SiteMenuLinkType  @map("link_type")
  pageId      String?           @map("page_id")
  page        SitePage?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  externalUrl String?           @map("external_url")
  sortOrder   Int               @default(0) @map("sort_order")
  isEnabled   Boolean           @default(true) @map("is_enabled")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([placement, sortOrder])
  @@map("site_menu_items")
}

/// User-authored asset or liability not otherwise tracked (cash, certificates, real estate, loans).
/// Self-reported (legal posture identical to TradeJournalEntry).
model ManualNetWorthComponent {
  id             String                @id @default(uuid())
  consumerUserId String                @map("consumer_user_id")
  consumerUser   ConsumerUser          @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  kind           NetWorthComponentKind
  category       NetWorthCategory
  label          String?
  amount         Decimal               @db.Decimal(24, 4)
  currency       String                @default("EGP")
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([consumerUserId, kind])
  @@map("manual_net_worth_components")
}

/// Point-in-time net worth with benchmark anchors for real-return math. One row per consumer per month.
model NetWorthSnapshot {
  id             String       @id @default(uuid())
  consumerUserId String       @map("consumer_user_id")
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  periodMonth    DateTime     @map("period_month") @db.Date
  capturedAt     DateTime     @default(now()) @map("captured_at")
  totalEgp       Decimal      @map("total_egp") @db.Decimal(24, 4)
  breakdown      Json
  usdEgpRate     Decimal?     @map("usd_egp_rate") @db.Decimal(18, 6)
  goldGramEgp    Decimal?     @map("gold_gram_egp") @db.Decimal(18, 6)
  inflationIndex Decimal?     @map("inflation_index") @db.Decimal(18, 6)
  dataFreshness  Json?        @map("data_freshness")

  @@unique([consumerUserId, periodMonth])
  @@index([consumerUserId, periodMonth(sort: Desc)])
  @@map("net_worth_snapshots")
}

/// User-defined wealth target. Informational planning only (no guaranteed returns).
model FinancialGoal {
  id                        String              @id @default(uuid())
  consumerUserId            String              @map("consumer_user_id")
  consumerUser              ConsumerUser        @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  label                     String
  targetAmountEgp           Decimal             @map("target_amount_egp") @db.Decimal(24, 4)
  targetDate                DateTime            @map("target_date") @db.Date
  savedSource               GoalSavedSource     @default(manual) @map("saved_source")
  manualSavedEgp            Decimal?            @map("manual_saved_egp") @db.Decimal(24, 4)
  savedCategory             NetWorthCategory?   @map("saved_category")
  illustrativeAnnualRatePct Decimal?            @map("illustrative_annual_rate_pct") @db.Decimal(6, 3)
  status                    FinancialGoalStatus @default(active)
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@index([consumerUserId, status])
  @@map("financial_goals")
}

/// Administratively managed EGP inflation reference (backend-served; clients never call externally).
model InflationBenchmark {
  id          String    @id @default(uuid())
  periodMonth DateTime  @unique @map("period_month") @db.Date
  indexValue  Decimal?  @map("index_value") @db.Decimal(18, 6)
  yoyRatePct  Decimal?  @map("yoy_rate_pct") @db.Decimal(8, 4)
  sourceLabel String    @map("source_label")
  asOf        DateTime? @map("as_of")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([periodMonth(sort: Desc)])
  @@map("inflation_benchmarks")
}

/// Glossary section tab (Learn → glossary categories).
model GlossaryCategory {
  id          String         @id @default(uuid())
  titleAr     String         @map("title_ar")
  titleEn     String         @map("title_en")
  sortOrder   Int            @default(0) @map("sort_order")
  isPublished Boolean        @default(false) @map("is_published")
  terms       GlossaryTerm[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("glossary_categories")
}

/// Bilingual investing glossary (Learn section).
model GlossaryTerm {
  id           String           @id @default(uuid())
  categoryId   String           @map("category_id")
  category     GlossaryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  termAr       String           @map("term_ar")
  termEn       String           @map("term_en")
  definitionAr String           @map("definition_ar") @db.Text
  definitionEn String           @map("definition_en") @db.Text
  sortOrder    Int              @default(0) @map("sort_order")
  isPublished  Boolean          @default(false) @map("is_published")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([categoryId, sortOrder])
  @@index([isPublished, sortOrder])
  @@map("glossary_terms")
}

/// Short educational articles (Learn section).
model LearnArticle {
  id               String     @id @default(uuid())
  slug             String     @unique
  titleAr          String     @map("title_ar")
  titleEn          String     @map("title_en")
  excerptAr        String?    @map("excerpt_ar") @db.Text
  excerptEn        String?    @map("excerpt_en") @db.Text
  contentAr        String     @map("content_ar") @db.Text
  contentEn        String     @map("content_en") @db.Text
  isPublished      Boolean    @default(false) @map("is_published")
  sortOrder        Int        @default(0) @map("sort_order")
  publishedAt      DateTime?  @map("published_at")
  createdByAdminId String?    @map("created_by_admin_id")
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("learn_articles")
}

/// YouTube course section (e.g. beginners, technical analysis).
model LearnCourseCategory {
  id            String              @id @default(uuid())
  titleAr       String              @map("title_ar")
  titleEn       String              @map("title_en")
  descriptionAr String?             @map("description_ar") @db.Text
  descriptionEn String?             @map("description_en") @db.Text
  sortOrder     Int                 @default(0) @map("sort_order")
  isPublished   Boolean             @default(false) @map("is_published")
  courses       LearnCourse[]
  lessons       LearnCourseLesson[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("learn_course_categories")
}

/// Course within a section — optional grouping for a series of lessons.
model LearnCourse {
  id                String              @id @default(uuid())
  categoryId        String              @map("category_id")
  category          LearnCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  titleAr           String              @map("title_ar")
  titleEn           String              @map("title_en")
  descriptionAr     String?             @map("description_ar") @db.Text
  descriptionEn     String?             @map("description_en") @db.Text
  youtubePlaylistId String?             @map("youtube_playlist_id")
  sortOrder         Int                 @default(0) @map("sort_order")
  isPublished       Boolean             @default(false) @map("is_published")
  lessons           LearnCourseLesson[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([categoryId, sortOrder])
  @@map("learn_courses")
}

/// YouTube lesson within a section — standalone (no course) or part of a course.
model LearnCourseLesson {
  id             String              @id @default(uuid())
  categoryId     String              @map("category_id")
  category       LearnCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  courseId       String?             @map("course_id")
  course         LearnCourse?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr        String              @map("title_ar")
  titleEn        String              @map("title_en")
  descriptionAr  String?             @map("description_ar") @db.Text
  descriptionEn  String?             @map("description_en") @db.Text
  youtubeVideoId String              @map("youtube_video_id")
  durationSec    Int?                @map("duration_sec")
  sortOrder      Int                 @default(0) @map("sort_order")
  isPublished    Boolean             @default(false) @map("is_published")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([categoryId, sortOrder])
  @@index([courseId, sortOrder])
  @@map("learn_course_lessons")
}

/// Curated EGX stock lists (sectors, thematic screens, market rules).
model EquityList {
  id            String             @id @default(uuid())
  code          String             @unique
  titleAr       String             @map("title_ar")
  titleEn       String             @map("title_en")
  descriptionAr String?            @map("description_ar") @db.Text
  descriptionEn String?            @map("description_en") @db.Text
  kind          EquityListKind
  sortOrder     Int                @default(0) @map("sort_order")
  isPublished   Boolean            @default(false) @map("is_published")
  /// TradingView `sector` strings used for bootstrap import (JSON string array).
  tvAliases     Json?              @map("tv_aliases")
  members       EquityListMember[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("equity_lists")
}

model EquityListMember {
  listId    String                 @map("list_id")
  list      EquityList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  symbol    String
  source    EquityListMemberSource @default(admin)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@id([listId, symbol])
  @@index([symbol])
  @@map("equity_list_members")
}
