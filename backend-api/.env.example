NODE_ENV=development
PORT=3000

# Optional: absolute path to openapi.yaml for GET /v1/openapi.{yaml,json} (defaults: ./contracts/openapi.yaml or monorepo specs/...)
OPENAPI_SPEC_PATH=
DATABASE_URL=postgresql://tharwa:tharwa@localhost:5432/tharwa
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API (one reflected origin per request).
# Production example (aaPanel Node env — do NOT duplicate these in nginx add_header):
# CORS_ORIGINS=https://thrwa.co,https://www.thrwa.co,https://7aduta.com,https://admin.thrwa.co,https://admin.7aduta.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Optional: JSON array of full FxRateItem objects — bypasses live FX when set
FX_MOCK_JSON=

# Optional: Egyptian metals from Telegram (same pattern as Personal Dashboard gold.py — pinned + t.me/s/@handle)
# Both must be set. Bot as channel admin enables pinned message; public channels also work via t.me preview scrape.
TELEGRAM_METALS_BOT_TOKEN=
# Public channel @handle (same as t.me/YourHandle), e.g. @goldprice10000 — required with token above
TELEGRAM_METALS_CHANNEL_ID=@goldprice10000
# Optional: merge latest unparsed bot queue posts (newest wins). Do not enable if anything else calls getUpdates on this token (409).
TELEGRAM_METALS_PEEK_UPDATES=0

# FX source: `tradingview` (default, uses @mathieuc/tradingview) or `http` (open.er-api, no key)
FX_PROVIDER=tradingview

# Optional: per-base TradingView ids, e.g. {"USD":"FX_IDC:USDEGP"}. ICE pairs use compact names (EUREGP not EUR_EGP). Gulf + JPY/CNY use USD-cross by default.
FX_TV_SYMBOLS=

# Used when FX_PROVIDER=http (USD-base open.er-api)
FX_HTTP_URL=https://open.er-api.com/v6/latest/USD

# Practice trading: virtual starting balance (EGP) and max indicative quote age for fills (seconds)
SIM_STARTING_CASH_EGP=100000
SIM_MAX_QUOTE_AGE_SEC=300

# Curated equities: TradingView chart quotes (`false` = null prices, history 503)
EQUITIES_TV_ENABLED=true

# Admin JWT (use a long random value in production)
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-32chars
ADMIN_ACCESS_TOKEN_TTL_SEC=3600

# Consumer JWT (separate secret; signed-in mobile routes). TTL max 90d (7776000s) in schema.
CONSUMER_JWT_SECRET=dev-consumer-jwt-secret-change-32ch
CONSUMER_ACCESS_TOKEN_TTL_SEC=604800
CONSUMER_REFRESH_TOKEN_TTL_SEC=2592000
PASSWORD_RESET_TOKEN_TTL_SEC=3600
EMAIL_VERIFICATION_TOKEN_TTL_SEC=86400

# Transactional email (Resend) — https://resend.com
RESEND_API_KEY=
RESEND_FROM=Tharwa <onboarding@resend.dev>
# Mobile deep links (token appended as ?token=…)
CONSUMER_PASSWORD_RESET_URL=tharwa://reset-password
CONSUMER_EMAIL_VERIFY_URL=tharwa://verify-email

# Social sign-in (Google / Apple) — POST /v1/auth/social
# Google Cloud Console → OAuth 2.0 Client IDs (Web + iOS + Android), comma-separated
GOOGLE_OAUTH_CLIENT_IDS=664527817047-og5m4g8e6e6fmurtqfr1qfffar0cmfsk.apps.googleusercontent.com,664527817047-m9cblrbp073u2u1q2n8cq4ev14htsdua.apps.googleusercontent.com,664527817047-fe6934gtfc3qooqiq4vsu1kps904mocd.apps.googleusercontent.com
# Apple bundle id / Services ID (must match the iOS app — com.tharwaapp)
APPLE_SIGN_IN_CLIENT_IDS=com.tharwaapp
METALS_GOLD_INSTRUMENT_CODE=GOLD_EGP
# Persist metal quotes to quote_snapshots (Postgres) every METALS_SNAPSHOT_INTERVAL_SEC
METALS_SNAPSHOT_ENABLED=true
METALS_SNAPSHOT_INTERVAL_SEC=300
METALS_SNAPSHOT_LEADER_TTL_SEC=120
# One-off channel history backfill (after build): npm run backfill:metal-history
# Options: --all (fetch until t.me ends) --dry-run --max-pages=200 --delay-ms=1500 --since=2025-01-01
OHLCV_PERSIST_ENABLED=true

# Per-IP limit for GET /v1/fx/rates, /v1/metals, /v1/stocks* (sliding 60s window)
PUBLIC_UPLOADS_DIR=./data/uploads
# Optional: absolute URLs in API for uploaded FX/metal icons (defaults to request host on upload)
# Production: PUBLIC_FILES_ORIGIN=https://api.thrwa.co
# PUBLIC_FILES_ORIGIN=http://localhost:3000
PUBLIC_RATE_LIMIT_MAX_PER_MINUTE=120
PUBLIC_HTTP_MAX_AGE_SEC=30
PUBLIC_HTTP_S_MAXAGE_SEC=90
PUBLIC_HTTP_STALE_WHILE_REVALIDATE_SEC=210
REDIS_CACHE_LOCK_TTL_SEC=45
REDIS_CACHE_WAIT_MS=25000

# Background upstream polling (Redis leader — one replica runs ticks)
UPSTREAM_POLL_ENABLED=true
UPSTREAM_POLL_INTERVAL_SEC=90
UPSTREAM_POLL_EGX_OPEN_SEC=90
UPSTREAM_POLL_EGX_OFFHOURS_SEC=300
UPSTREAM_POLL_LEADER_TTL_SEC=120

# Mubasher corporate calendar (AMR) — sync once per Cairo day, up to 3 retries
CORPORATE_CALENDAR_SYNC_ENABLED=true
CORPORATE_CALENDAR_SYNC_CHECK_INTERVAL_SEC=3600
CORPORATE_CALENDAR_SYNC_MAX_RETRIES=3
CORPORATE_CALENDAR_SYNC_LEADER_TTL_SEC=600

# Daily market + watchlist push briefs (Cairo timezone, leader-elected)
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_CHECK_INTERVAL_SEC=60
DAILY_BRIEF_HOUR=15
DAILY_BRIEF_MINUTE=15
DAILY_BRIEF_LEADER_TTL_SEC=120

# Secrets: upstream_connections.secret_ref → env var name (see docs/secrets.md)
SECRETS_BACKEND=env

# Optional FCM fallback if not uploaded via Admin → Settings → Integrations.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Meta (Facebook / Instagram) — Admin → Social posts OAuth + scheduled publishing
# IMPORTANT: OAuth callback must hit the backend API, not the admin SPA.
# Use api.thrwa.co (or nginx proxy /admin/v1 on admin host to port 3000).
# In Meta App Dashboard: add Use case "Manage your Pages" before OAuth.
# Default OAuth scopes include Instagram (pages_read_engagement + instagram_basic + instagram_content_publish).
# Required to read instagram_business_account even when @thrwa.co is linked in Business Suite.
# Enable Instagram + Manage Pages use cases in Meta App Dashboard before OAuth.
# Override for Facebook-only (no Instagram):
# META_OAUTH_SCOPES=pages_show_list
# Optional full override:
# META_OAUTH_SCOPES=pages_show_list,instagram_basic,instagram_content_publish,pages_read_engagement,business_management
# ADMIN_PUBLIC_ORIGIN=https://admin.thrwa.co
# Create a Meta app, add Facebook Login + permissions, set redirect to backend callback.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://api.thrwa.co/admin/v1/social/meta/oauth/callback
# SOCIAL_PUBLIC_FILES_ORIGIN=https://api.thrwa.co
# SOCIAL_POST_ENABLED=true
# SOCIAL_GOLD_DAILY_HOUR=10
# SOCIAL_EGX_CLOSE_HOUR=15
# SOCIAL_EGX_CLOSE_MINUTE=15
# SOCIAL_GOLD_ALERT_DROP_PCT=10

# Observability (optional)
SERVICE_NAME=tharwa-backend-api
BUILD_SHA=dev
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Gold daily voiceover — Gemini 3.1 Flash TTS (default). Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Autonoe
# GEMINI_TTS_STYLE=Read in Egyptian Arabic dialect with an energetic, clear promotional tone for a finance app. Pronounce numbers naturally.

# YouTube Shorts OAuth (admin → Social → Connect YouTube). Create OAuth client in Google Cloud Console.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=https://api.example.com/admin/v1/social/youtube/oauth/callback
